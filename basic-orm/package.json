{
  "name": "basic-orm",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "Basic ORM example demonstrating @bunary/orm models on Drizzle",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "start": "bun run src/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:setup": "bun run src/db/setup.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bunary/core": "^0.4.0",
    "@bunary/orm": "^0.4.0",
    "drizzle-orm": "^0.45.0"
  },
  "devDependencies": {
    "@types/bun": "^1.3.6",
    "drizzle-kit": "^0.31.0",
    "typescript": "^7.0.2"
  }
}
